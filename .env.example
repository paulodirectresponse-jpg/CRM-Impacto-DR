# OPENAI_API_KEY: Required for AI scoring, script generation, and funnel bottleneck diagnosis.
# Users configure this via server environment or settings.
OPENAI_API_KEY="your-openai-api-key-here"

# OPENAI_MODEL: Model name for OpenAI calls (default: gpt-5.6-luna)
OPENAI_MODEL="gpt-5.6-luna"

# AUTHORIZED_EMAILS: Comma-separated list of emails authorized to access the CRM
# Example: ferramentaas.1@gmail.com,paulo.direct.response@gmail.com
AUTHORIZED_EMAILS="ferramentaas.1@gmail.com,paulo.direct.response@gmail.com"

# PORT: Server port (default: 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Admin Service Account Credentials (Required for external hosting such as Railway)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

